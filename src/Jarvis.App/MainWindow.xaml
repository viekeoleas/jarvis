<Window x:Class="Jarvis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jarvis"
        Width="440"
        Height="455"
        MinWidth="380"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBackground}"
        Foreground="{StaticResource PrimaryText}"
        ShowInTaskbar="False">
    <Border Padding="22"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="JARVIS"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Official ChatGPT Plus connection"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelSurface}"
                        CornerRadius="12">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{StaticResource Accent}" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountStatus}"
                               Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="No API key or metered API billing"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="0,0,8,0"
                        MinWidth="76"
                        Padding="12,8"
                        Click="History_Click"
                        Content="History"
                        Background="{StaticResource PanelSurface}"
                        Foreground="{StaticResource Accent}"
                        BorderBrush="{StaticResource PanelBorder}" />
                <Button Grid.Column="2"
                        MinWidth="156"
                        Padding="16,9"
                        Click="SignIn_Click"
                        Content="{Binding SignInButtonText}"
                        IsEnabled="{Binding IsSignInEnabled}"
                        Background="{StaticResource Accent}"
                        Foreground="#081018"
                        FontWeight="SemiBold"
                        BorderThickness="0" />
            </Grid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Local voice"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryText}" />
                        <Border Margin="10,0,0,0"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Background="#D92D4A"
                                CornerRadius="10"
                                Visibility="{Binding ListeningIndicatorVisibility}">
                            <TextBlock Text="●  СЛУШАЮ"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding VoiceStatus}"
                               Margin="0,2,12,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="0,0,8,0"
                        MinWidth="76"
                        Padding="12,7"
                        Click="EnrollWake_Click"
                        Content="Enrol"
                        Background="{StaticResource PanelSurface}"
                        Foreground="{StaticResource Accent}"
                        BorderBrush="{StaticResource PanelBorder}" />
                <Button Grid.Column="2"
                        MinWidth="124"
                        Padding="14,7"
                        Click="ToggleSpeech_Click"
                        Content="{Binding VoiceButtonText}"
                        IsEnabled="{Binding CanToggleVoice}"
                        Background="{StaticResource PanelSurface}"
                        Foreground="{StaticResource Accent}"
                        BorderBrush="{StaticResource PanelBorder}" />
            </Grid>

            <TextBox Grid.Row="3"
                     Margin="0,18,0,12"
                     Padding="12,9"
                     Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource PanelSurface}"
                     Foreground="{StaticResource PrimaryText}"
                     BorderBrush="{StaticResource PanelBorder}"
                     CaretBrush="{StaticResource Accent}"
                     ToolTip="Enter a request for Jarvis" />

            <Border Grid.Row="4"
                    Padding="12"
                    Background="{StaticResource PanelSurface}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="{Binding Output}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource PrimaryText}" />
            </Border>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Text="Win+Shift+2 — начать или остановить голос"
                           Foreground="{StaticResource SecondaryText}" />
                <Button Grid.Column="1"
                        MinWidth="92"
                        Padding="16,8"
                        Click="RunTracer_Click"
                        Content="Send"
                        IsEnabled="{Binding CanSend}"
                        Background="{StaticResource Accent}"
                        Foreground="#081018"
                        BorderThickness="0" />
            </Grid>
        </Grid>
    </Border>
</Window>
